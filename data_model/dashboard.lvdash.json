{
  "datasets": [
    {
      "name": "ds_expiring_licensors",
      "displayName": "Agreements expiring in 90 days by licensor",
      "queryLines": [
        "SELECT h.rights_holder_name AS licensor, COUNT(*) AS agreements_expiring, MIN(a.expiry_date) AS first_expiry, SUM(a.total_license_fee) AS fee_expiring ",
        "FROM {catalog}.{prefix}rights.license_agreement a ",
        "JOIN {catalog}.{prefix}rights.holder h ON a.primary_license_holder_id = h.holder_id ",
        "WHERE a.agreement_status = 'Active' AND a.expiry_date BETWEEN current_date() AND date_add(current_date(), 90) ",
        "GROUP BY h.rights_holder_name ",
        "ORDER BY agreements_expiring DESC, licensor"
      ]
    },
    {
      "name": "ds_licence_fees_top10",
      "displayName": "Active licence fees by licensor, top 10",
      "queryLines": [
        "SELECT h.rights_holder_name AS licensor, COUNT(*) AS active_agreements, SUM(a.total_license_fee) AS total_license_fee ",
        "FROM {catalog}.{prefix}rights.license_agreement a ",
        "JOIN {catalog}.{prefix}rights.holder h ON a.primary_license_holder_id = h.holder_id ",
        "WHERE a.agreement_status = 'Active' ",
        "GROUP BY h.rights_holder_name ",
        "ORDER BY total_license_fee DESC ",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_overdue_royalties_top10",
      "displayName": "Overdue royalty statements by licensor, top 10",
      "queryLines": [
        "SELECT h.rights_holder_name AS licensor, COUNT(*) AS overdue_statements, SUM(r.net_royalty_amount) AS overdue_net_royalty ",
        "FROM {catalog}.{prefix}rights.royalty_statement r ",
        "JOIN {catalog}.{prefix}rights.holder h ON r.holder_id = h.holder_id ",
        "WHERE r.statement_status = 'Overdue' ",
        "GROUP BY h.rights_holder_name ",
        "ORDER BY overdue_net_royalty DESC ",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_content_windows",
      "displayName": "Active content windows by territory group and window type",
      "queryLines": [
        "SELECT t.territory_group, c.window_type, COUNT(*) AS active_windows ",
        "FROM {catalog}.{prefix}rights.content_window c ",
        "JOIN {catalog}.{prefix}rights.territory t ON c.territory_id = t.territory_id ",
        "WHERE c.availability_status = 'Active' ",
        "GROUP BY t.territory_group, c.window_type ",
        "ORDER BY t.territory_group, c.window_type"
      ]
    },
    {
      "name": "ds_ad_delivery_by_advertiser",
      "displayName": "Ordered vs delivered impressions by advertiser, top 10",
      "queryLines": [
        "WITH ordered AS (SELECT advertiser_id, SUM(target_impressions) AS ordered_impressions FROM {catalog}.{prefix}sales.campaign GROUP BY advertiser_id), ",
        "delivered AS (SELECT c.advertiser_id, SUM(d.total_impressions_served) AS delivered_impressions FROM {catalog}.{prefix}sales.impression_delivery d JOIN {catalog}.{prefix}sales.campaign c ON d.campaign_id = c.campaign_id GROUP BY c.advertiser_id) ",
        "SELECT a.trade_name AS advertiser, o.ordered_impressions, dl.delivered_impressions, ROUND(dl.delivered_impressions / o.ordered_impressions, 3) AS delivery_ratio ",
        "FROM delivered dl ",
        "JOIN ordered o ON dl.advertiser_id = o.advertiser_id ",
        "JOIN {catalog}.{prefix}sales.advertiser a ON a.advertiser_id = dl.advertiser_id ",
        "ORDER BY delivered_impressions DESC ",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_cpm_by_campaign_type",
      "displayName": "Realised CPM by campaign type",
      "queryLines": [
        "SELECT c.campaign_type, SUM(d.revenue_amount) * 1000 / SUM(d.total_impressions_served) AS realised_cpm, SUM(d.total_impressions_served) AS delivered_impressions ",
        "FROM {catalog}.{prefix}sales.impression_delivery d ",
        "JOIN {catalog}.{prefix}sales.campaign c ON d.campaign_id = c.campaign_id ",
        "GROUP BY c.campaign_type ",
        "ORDER BY realised_cpm DESC"
      ]
    },
    {
      "name": "ds_ad_revenue_monthly",
      "displayName": "Ad revenue by month, complete months",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', d.delivery_date) AS month, SUM(d.revenue_amount) AS ad_revenue ",
        "FROM {catalog}.{prefix}sales.impression_delivery d ",
        "WHERE d.delivery_date < DATE_TRUNC('MONTH', current_date()) ",
        "GROUP BY DATE_TRUNC('MONTH', d.delivery_date) ",
        "ORDER BY month"
      ]
    },
    {
      "name": "ds_mg_by_deal_type",
      "displayName": "Minimum guarantees recouped vs outstanding by deal type",
      "queryLines": [
        "SELECT d.deal_type, 'Recouped' AS balance, SUM(mg.recouped_to_date_amount) AS amount ",
        "FROM {catalog}.{prefix}partner.minimum_guarantee mg ",
        "JOIN {catalog}.{prefix}partner.acquisition_deal d ON mg.acquisition_deal_id = d.acquisition_deal_id ",
        "GROUP BY d.deal_type ",
        "UNION ALL ",
        "SELECT d.deal_type, 'Outstanding' AS balance, SUM(mg.outstanding_balance_amount) AS amount ",
        "FROM {catalog}.{prefix}partner.minimum_guarantee mg ",
        "JOIN {catalog}.{prefix}partner.acquisition_deal d ON mg.acquisition_deal_id = d.acquisition_deal_id ",
        "GROUP BY d.deal_type ",
        "ORDER BY 1, 2"
      ]
    }
  ],
  "pages": [
    {
